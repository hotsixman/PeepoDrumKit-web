{
	"extends": "@tsconfig/svelte/tsconfig.json",
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
		"types": ["vite/client"],
		"strict": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"allowJs": false
	},
	"include": ["src/**/*.ts", "src/**/*.svelte", "tests/**/*.ts"]
}
